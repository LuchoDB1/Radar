# Radar — variables de entorno
# Copiar a .env.local y llenar con valores reales

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here   # solo server-side, NO expone al cliente

# === Cron auth ===
CRON_SECRET=generar-con-openssl-rand-hex-32     # protege /api/cron de invocación externa
